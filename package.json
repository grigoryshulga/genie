{
  "name": "genie",
  "version": "0.4.0",
  "private": true,
  "description": "The web UI of the genie server, the pi extensions its agents run with, and their tests.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "build:web": "vite build --config web/vite.config.ts",
