# Copy to docker/.env (never commit it). Used by docker/docker-compose.yml; every value is optional.

# --- network --------------------------------------------------------------------------------------
# Port of the web UI, same on the host and inside the container.
GENIE_PORT=7420
# Interface the port is published on. 127.0.0.1 = this machine only (use a reverse proxy for the rest).
GENIE_HOST_BIND=127.0.0.1
# Address people open in the browser, no trailing slash. Used in links of mails and Telegram messages;
# its host is added to the accepted Host headers automatically.
GENIE_PUBLIC_URL=
# More accepted Host header values, comma-separated: names or addresses you open the UI by
# (e.g. 192.168.1.20,genie.lan). Requests with any other Host are refused (DNS rebinding protection).
GENIE_ALLOW_HOSTS=

# --- user ids -------------------------------------------------------------------------------------
# Ids the server and agents run as. Set them to the owner of the repositories you mount
# (`id -u`, `id -g`); with volumes only, leave the defaults.
GENIE_UID=1000
GENIE_GID=1000

# --- models: provider credentials for pi ---------------------------------------------------------
# Any variable pi recognizes works (list: docs/providers.md of @earendil-works/pi-coding-agent).
# Alternatively keep credentials and custom providers (models.json) in /data/home/.pi/agent.
# Each role names its model in <data>/agents/<role>.md; see docs/platform/agent-roles-and-teams.md.
# LiteLLM (see docs/platform/docker.md, "Models and credentials"); to keep the key in a file use docker/docker-compose.secrets.yml.
# With user accounts, agents use personal keys or shared provider defaults configured in Settings.
# Server environment keys are used in local mode.
# LITELLM_API_KEY=
# The server's service key to read LiteLLM's model tariffs (GET /model/info): no model calls, never
# given to agents. Needed only for prices from LiteLLM; see "Usage and budgets" in docs/platform/settings.md.
# LITELLM_INFO_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# --- git ------------------------------------------------------------------------------------------
# Token for HTTPS pushes/fetches to github.com (fine-grained, limited to the repositories of the projects).
# Legacy local projects can pass it to agents; hosted connections use repository tokens on the server.
# See docs/platform/git-repositories.md for hosted Git credentials and policies.
# GITHUB_TOKEN=
# Author of the commits made by agents (defaults to "genie <genie@genie.local>").
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# --- image and limits -----------------------------------------------------------------------------
TZ=UTC
# Prebuilt image instead of building locally (docker login ghcr.io first for a private repository):
# GENIE_IMAGE=ghcr.io/<owner>/<repo>:latest
# Extra Debian packages baked into the image when it is built, e.g. toolchains for your projects:
# EXTRA_APT_PACKAGES=python3 python3-venv build-essential
# A Rust toolchain for agents on Rust projects (clippy, rustfmt, gcc, mold) and their shared build cache
# under /data/cache; GENIE_AGENT_BUILD_JOBS bounds cargo's jobs per agent (default 8).
# RUST_TOOLCHAIN=stable
# GENIE_AGENT_BUILD_JOBS=8
# Agent sandbox: off (default here), auto, or bwrap (needs docker/docker-compose.sandbox.yml; see docs/platform/docker.md)
# GENIE_SANDBOX=off
# Memory ceiling of the container ("8g"; 0 = unlimited) and its process limit. Every live agent session
# is a Node process: ~0.5 GB each (a fresh one is ~170 MB, long conversations grow), plus ~2 GB for the
# server and what agents build. So about 8g for the default runtime.maxSessions of 12, 5g for 6.
# Idle sessions stop after runtime.idleStopSecs (300) and a pi process's V8 heap is capped by
# runtime.nodeHeapMb (2048); see docs/platform/docker.md, "Project tools and resource limits".
GENIE_MEM_LIMIT=0
GENIE_PIDS_LIMIT=4096
